<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Bond.Tools.IconGen</RootNamespace>
        <AssemblyName>IconGen</AssemblyName>
        <!-- 独立工具工程，不参与主应用编译（见 BondClient/Bond.csproj 的 tools 排除项） -->
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Svg.Skia" Version="5.0.0" />
        <PackageReference Include="SkiaSharp" Version="3.119.2" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
    </ItemGroup>

</Project>
