<Application x:Class="BondClient.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <sukiUi:SukiTheme ThemeColor="Orange" />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style Selector="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource BondTertiary}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <!-- Theme-switchable color resources (updated at runtime) -->
        <SolidColorBrush x:Key="BondPrimary" Color="#FF141413" />
        <SolidColorBrush x:Key="BondSecondary" Color="#FF6F6A63" />
        <SolidColorBrush x:Key="BondTertiary" Color="#FF9A948B" />
        <SolidColorBrush x:Key="BondDisabled" Color="#FFB0AEA5" />
        <SolidColorBrush x:Key="BondBg" Color="#FFFAF9F5" />
        <SolidColorBrush x:Key="BondSurface" Color="#FFF3EFE8" />
        <SolidColorBrush x:Key="BondBorder" Color="#FFE8E6DC" />
        <SolidColorBrush x:Key="BondAccent" Color="#FFD46A4C" />
        <SolidColorBrush x:Key="BondSuccess" Color="#FF5D7358" />
        <SolidColorBrush x:Key="BondError" Color="#FFA34A42" />
        <SolidColorBrush x:Key="BondStroke" Color="#FF9A948B" />
        <!-- Icons -->
        <StreamGeometry x:Key="Ico.Settings">M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051 2.34 2.34 0 0 0 9.67 4.136zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
