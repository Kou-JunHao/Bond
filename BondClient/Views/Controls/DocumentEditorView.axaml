<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Bond.Views.Controls.DocumentEditorView">
    <Panel Background="{DynamicResource BondSurfaceAlt}">
        <!-- WebView2 原生控件挂载点 -->
        <Panel x:Name="HostContainer" ClipToBounds="True" />

        <!-- 首次创建 WebView2 时的占位（几百毫秒） -->
        <StackPanel x:Name="LoadingPanel" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
            <TextBlock Classes="meta" Text="正在准备富文本编辑器…" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 初始化失败 / 内核报错时的兜底：明确原因 + 复制内容，绝不白屏 -->
        <Border x:Name="FallbackPanel" IsVisible="False" Padding="28"
                Background="{DynamicResource BondSurface}">
            <StackPanel Spacing="10" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="AlertCircleOutline" IconSize="30"
                                Foreground="{DynamicResource BondWarning}" HorizontalAlignment="Center" />
                <TextBlock Text="编辑器未能启动" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackText" Classes="sub" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Classes="meta" TextWrapping="Wrap" TextAlignment="Center"
                           Text="文档内容仍保存在服务器上；你可以把当前草稿复制出来，避免丢失。" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button x:Name="CopyButton" Classes="outline" Content="复制当前内容到剪贴板"
                            Click="OnCopyContentClick" />
                    <Button x:Name="RetryButton" Classes="primary" Content="重试"
                            Click="OnRetryClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
