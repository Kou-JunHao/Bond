<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Bond.ViewModels"
             x:Class="Bond.Views.Controls.SelectionBar"
             x:DataType="vm:FilesPageViewModel">

    <!-- task-166：选中操作条 = 文件页唯一的操作入口（行内/平铺卡 hover 按钮已全部移除）。
         视觉：高 52、圆角 14、BondSurfaceGlass（底色带 8% 透明，底下内容轻微透出）+ 1px BondBorder；
         阴影只给亮色主题（暗色由 1px 边框承担，见 SelectionBar.axaml.cs）。
         进出场：TranslateY 8→0 + Opacity 0→1，160ms EaseOut，由代码隐藏做。 -->
    <Border x:Name="Root" Height="52" MinWidth="420" CornerRadius="14" Padding="12,0"
            Background="{DynamicResource BondSurfaceGlass}"
            BorderBrush="{DynamicResource BondBorder}"
            BorderThickness="1"
            Opacity="0"
            IsHitTestVisible="False">
        <Border.BoxShadow>0 10 28 0 #2E1B1A17</Border.BoxShadow>

        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- 常态：选中摘要 + 下载 / 分享 / 重命名 / 移动 / 复制链接 / 删除 -->
            <Grid x:Name="NormalRow" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsConfirmingDelete}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionBarText}" FontSize="12.5" FontWeight="Medium"
                               MaxWidth="300" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SelectionBarText}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="18" Background="{DynamicResource BondBorder}"
                            VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 主操作（下载 / 分享）：强调色图标 + 文案，不做实底 -->
                    <Button Classes="ghosticon" Command="{Binding DownloadSelectionCommand}"
                            Padding="12,0" MinHeight="40" ToolTip.Tip="下载选中的文件（逐个下载，文件夹跳过）">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Download" IconSize="18"
                                             Foreground="{DynamicResource BondAccent}" />
                            <TextBlock Text="下载" FontSize="12.5"
                                       Foreground="{DynamicResource BondAccent}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghosticon" Command="{Binding ShareSelectionCommand}"
                            Padding="12,0" MinHeight="40"
                            IsEnabled="{Binding CanShareSelection}"
                            ToolTip.Tip="{Binding ShareSelectionHint}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="ShareVariant" IconSize="18"
                                             Foreground="{DynamicResource BondAccent}" />
                            <TextBlock Text="分享" FontSize="12.5"
                                       Foreground="{DynamicResource BondAccent}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghosticon" Command="{Binding RenameSelectionCommand}"
                            Padding="12,0" MinHeight="40"
                            IsEnabled="{Binding CanRenameSelection}" ToolTip.Tip="重命名（仅单选）">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Pencil" IconSize="18" />
                            <TextBlock Text="重命名" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghosticon" Command="{Binding MoveSelectionCommand}"
                            Padding="12,0" MinHeight="40"
                            IsEnabled="{Binding CanMoveSelection}"
                            ToolTip.Tip="{Binding MoveSelectionHint}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="FolderMoveOutline" IconSize="18" />
                            <TextBlock Text="移动" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghosticon" Command="{Binding CopySelectionLinkCommand}"
                            Padding="12,0" MinHeight="40"
                            IsEnabled="{Binding CanCopyLinkSelection}"
                            ToolTip.Tip="{Binding CopyLinkSelectionHint}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="LinkVariant" IconSize="18" />
                            <TextBlock Text="复制链接" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <!-- 破坏性操作：红字 + 红图标，不做实底 -->
                    <Button Classes="ghosticon" Command="{Binding RequestDeleteSelectionCommand}"
                            Padding="12,0" MinHeight="40" ToolTip.Tip="删除选中项目（Del，二次确认）">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Delete" IconSize="18"
                                             Foreground="{DynamicResource BondError}" />
                            <TextBlock Text="删除" FontSize="12.5"
                                       Foreground="{DynamicResource BondError}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Classes="ghosticon" Command="{Binding ClearSelectionCommand}"
                        Padding="8,0" MinHeight="40" Margin="8,0,0,0" ToolTip.Tip="取消选择（Esc）">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Close" IconSize="16" />
                        <TextBlock Text="取消选择" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 删除二次确认：同一条操作条切换态 -->
            <Grid x:Name="ConfirmRow" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsConfirmingDelete}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="AlertOutline" IconSize="16"
                                     Foreground="{DynamicResource BondWarning}"
                                     VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeleteConfirmText}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="soft" Command="{Binding CancelDeleteCommand}"
                            Padding="14,0" MinHeight="36">
                        <TextBlock Text="取消" FontSize="12.5" />
                    </Button>
                    <Button Classes="primary" Command="{Binding ConfirmDeleteCommand}"
                            Padding="14,0" MinHeight="36"
                            Background="{DynamicResource BondError}">
                        <TextBlock Text="删除" FontSize="12.5" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
