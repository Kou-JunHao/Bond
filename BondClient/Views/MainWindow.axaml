<suki:SukiWindow x:Class="Bond.Views.MainWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:vm="using:Bond.ViewModels"
                 xmlns:models="using:Bond.Models"
                 xmlns:pages="using:Bond.Views.Pages"
                 xmlns:controls="using:Bond.Views.Controls"
                 x:DataType="vm:MainWindowViewModel"
                 Title="Bond"
                 Width="1120" Height="720"
                 MinWidth="1040" MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 BackgroundStyle="Flat"
                 IsMenuVisible="False"
                 IsTitleBarVisible="True"
                 CanFullScreen="True"
                 MaxWidthScreenRatio="0.94"
                 MaxHeightScreenRatio="0.90"
                 CanMove="True"
                 TitleFontSize="15"
                 TitleFontWeight="SemiBold"
                 ShowBottomBorder="False">

    <suki:SukiWindow.LogoContent>
        <Image Source="avares://Bond/Assets/logo.png" Width="24" Height="24" />
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button Classes="ghosticon" Padding="6,4" MinWidth="32" ToolTip.Tip="账户菜单">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="账户设置" Click="OnAccountSettingsClick" />
                        <MenuItem Header="切换账号 / 退出登录" Click="OnSignOutClick" />
                        <Separator />
                        <MenuItem Header="退出 Bond" Click="OnAppExitClick" />
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                            Background="{DynamicResource BondAccentSoft}">
                        <Panel>
                            <Image Source="{Binding AvatarSource}" Stretch="UniformToFill"
                                   IsVisible="{Binding HasAvatar}" />
                            <TextBlock Text="{Binding AccountInitial}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BondAccent}"
                                       IsVisible="{Binding !HasAvatar}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                    <TextBlock Text="{Binding AccountName}" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center" MaxWidth="110"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BondPrimary}" />
                    <mi:MaterialIcon Kind="ChevronDown" IconSize="12"
                                     Foreground="{DynamicResource BondStroke}"
                                     VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- task-7：系统公告铃铛（未读数字徽标；点击展开非阻塞公告面板） -->
            <Button Classes="ghosticon" Padding="6,4" MinWidth="32" ToolTip.Tip="公告"
                    Command="{Binding ToggleAnnouncementsCommand}">
                <Panel>
                    <mi:MaterialIcon Kind="Bell" IconSize="14"
                                     Foreground="{DynamicResource BondSecondary}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border MinWidth="16" Height="16" CornerRadius="8" Padding="3,0"
                            Background="{DynamicResource BondError}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-4,-6,0"
                            IsVisible="{Binding HasUnreadAnnouncements}"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding UnreadAnnouncementBadgeText}" FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BondOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </Button>

            <Button Classes="soft" Command="{Binding MinimizeToBallCommand}"
                    Padding="9,4" MinHeight="32" ToolTip.Tip="隐藏主窗口，只保留桌面悬浮球">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="Monitor" IconSize="12"
                                     Foreground="{DynamicResource BondSecondary}" />
                    <TextBlock Text="悬浮球" FontSize="11.5"
                               Foreground="{DynamicResource BondSecondary}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <!-- 页面内容直接挂在 SukiSideMenuItem.PageContent 上 -->
    <!-- task-153：界面缩放只作用于主窗口内容。LayoutTransformControl 会按倍率重新测量/布局，
         不像 RenderTransform 那样把超出窗口的部分裁掉；悬浮球窗口不参与缩放。 -->
    <LayoutTransformControl x:Name="ZoomHost">
    <suki:SukiSideMenu x:Name="SideMenu"
                       IsMenuExpanded="True"
                       OpenPaneLength="212"
                       IsSearchEnabled="False"
                       IsToggleButtonVisible="True"
                       SidebarToggleEnabled="True"
                       HeaderMinHeight="8">

        <suki:SukiSideMenuItem Header="文件"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <mi:MaterialIcon Kind="Folder" IconSize="17" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:FilesPage x:Name="FilesPageView" DataContext="{Binding Files}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="工作区"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <mi:MaterialIcon Kind="AccountGroup" IconSize="17" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:WorkspacePage DataContext="{Binding Workspaces}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="传输"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <Panel>
                    <mi:MaterialIcon Kind="Upload" IconSize="17"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- 折叠态：图标右上角小圆点（不塞数字） -->
                    <Border x:Name="TransferDot" Width="8" Height="8" CornerRadius="4"
                            Background="{DynamicResource BondAccent}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,-2,0" IsVisible="False" IsHitTestVisible="False" />
                </Panel>
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:TransferPage DataContext="{Binding Transfers}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="设备"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <mi:MaterialIcon Kind="Devices" IconSize="17" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:DevicesPage DataContext="{Binding Devices}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="会话"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <Panel>
                    <mi:MaterialIcon Kind="Chat" IconSize="17" />
                    <!-- 未读徽标：会话列表未读总数（折叠态也可见，随 ChatChanged 刷新） -->
                    <Border Width="16" Height="16" CornerRadius="8"
                            Background="{DynamicResource BondAccent}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-4,-6,0"
                            IsVisible="{Binding Chat.HasUnreadTotal}"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding Chat.UnreadTotalText}" FontSize="9"
                                   Foreground="{DynamicResource BondOnAccent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:ChatPage DataContext="{Binding Chat}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <!-- 2026-10-29：分享管理独立成页（用户反馈「客户端没有直接的管理分享链接的页面」）。
             数据复用 FilesPageViewModel（与文件页的「我的分享」快捷面板同源）。 -->
        <suki:SukiSideMenuItem x:Name="SharesNavItem" Header="分享"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <mi:MaterialIcon Kind="ShareVariant" IconSize="17" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:SharesPage DataContext="{Binding Files}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="笔记"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <mi:MaterialIcon Kind="FileDocumentMultipleOutline" IconSize="17" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:DocsPage DataContext="{Binding Docs}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="设置"
                               HorizontalAlignment="Stretch"
                               Background="Transparent" PointerPressed="OnSidebarItemPressed">
            <suki:SukiSideMenuItem.Icon>
                <mi:MaterialIcon Kind="Cog" IconSize="17" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <pages:SettingsPage DataContext="{Binding Settings}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

    </suki:SukiSideMenu>
    </LayoutTransformControl>
    <!-- 全局 Toast + 侧栏传输徽标 + 预览覆盖层：挂在 SukiWindow.Hosts 上，覆盖所有页面 -->
    <suki:SukiWindow.Hosts>
        <Panel IsHitTestVisible="False">
            <Canvas x:Name="BadgeLayer" IsHitTestVisible="False">
                <!-- 展开态数字徽标（初始放到屏幕外，定位失败时不会停在左上角） -->
                <Border x:Name="TransferBadge" IsVisible="False" Height="17" MinWidth="17"
                        CornerRadius="8.5" Background="{DynamicResource BondAccent}"
                        Padding="5,0" RenderTransformOrigin="50%,50%"
                        Canvas.Left="-999" Canvas.Top="-999"
                        IsHitTestVisible="False" Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <TextBlock x:Name="TransferBadgeText" Text="0" FontSize="9.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource BondOnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Canvas>

            <Border x:Name="ToastBar" IsVisible="False" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26" Padding="14,9" CornerRadius="10"
                    Background="{DynamicResource BondSurface}"
                    BorderBrush="{DynamicResource BondBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon x:Name="ToastIcon" Kind="InformationOutline" IconSize="14"
                                     VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" FontSize="12.5" MaxWidth="520"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- ===== task-7：公告面板（右上角铃铛弹出；非阻塞：点遮罩 / Esc / 再点铃铛关闭）===== -->
        <Border x:Name="AnnouncementOverlay"
                IsVisible="{Binding IsAnnouncementsOpen}"
                Background="Transparent"
                PointerPressed="OnAnnouncementsBackdropPressed">
            <Border Width="430" MaxHeight="640"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,56,16,0"
                    Background="{DynamicResource BondSurface}"
                    BorderBrush="{DynamicResource BondBorder}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True">
                <Border.Styles>
                    <Style Selector="Border.announcement-item">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="14,12" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <Style Selector="Border.announcement-item:pointerover">
                        <Setter Property="Background" Value="{DynamicResource BondSurfaceAlt}" />
                    </Style>
                    <Style Selector="TextBlock.announcement-title">
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Foreground" Value="{DynamicResource BondPrimary}" />
                    </Style>
                    <Style Selector="TextBlock.announcement-title.unread">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </Border.Styles>

                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 头部：标题 + 摘要 + 刷新/关闭 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,10,10">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="公告" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BondPrimary}" />
                            <TextBlock Text="{Binding AnnouncementsSummaryText}" FontSize="11.5"
                                       Foreground="{DynamicResource BondTertiary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="34" Height="3"
                                         IsVisible="{Binding IsAnnouncementsLoading}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Classes="ghosticon" Padding="6" MinWidth="30" MinHeight="30"
                                    Command="{Binding RefreshAnnouncementsCommand}" ToolTip.Tip="刷新公告">
                                <mi:MaterialIcon Kind="Refresh" IconSize="14" />
                            </Button>
                            <Button Classes="ghosticon" Padding="6" MinWidth="30" MinHeight="30"
                                    Command="{Binding CloseAnnouncementsCommand}" ToolTip.Tip="关闭 (Esc)">
                                <mi:MaterialIcon Kind="Close" IconSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BondBorder}" />

                    <!-- 正文：错误条 + 列表 / 加载 / 空态 -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" IsVisible="{Binding HasAnnouncementsError}"
                                Margin="12,8,12,0" Padding="10,8" CornerRadius="8"
                                Background="{DynamicResource BondAccentSoft}"
                                BorderBrush="{DynamicResource BondBorder}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" IconSize="14"
                                                 Foreground="{DynamicResource BondError}"
                                                 VerticalAlignment="Top" Margin="0,1,7,0" />
                                <TextBlock Grid.Column="1" Text="{Binding AnnouncementsError}"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BondSecondary}" />
                                <Button Grid.Column="2" Classes="ghosticon" Padding="5"
                                        MinWidth="26" MinHeight="26"
                                        Command="{Binding RefreshAnnouncementsCommand}"
                                        ToolTip.Tip="重试">
                                    <mi:MaterialIcon Kind="Refresh" IconSize="13" />
                                </Button>
                            </Grid>
                        </Border>

                        <Panel Grid.Row="1">
                            <!-- 公告列表（服务端按发布时间倒序；正文保留换行） -->
                            <ScrollViewer IsVisible="{Binding HasAnnouncements}"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="8,6">
                                <ItemsControl ItemsSource="{Binding Announcements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AnnouncementItem">
                                            <Border Classes="announcement-item"
                                                    PointerPressed="OnAnnouncementItemPressed">
                                                <Grid ColumnDefinitions="3,*">
                                                    <!-- level 左侧色条：info=次级 / warn=BondWarning / critical=BondError -->
                                                    <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                            Background="{DynamicResource BondTertiary}"
                                                            IsVisible="{Binding IsInfo}" />
                                                    <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                            Background="{DynamicResource BondWarning}"
                                                            IsVisible="{Binding IsWarn}" />
                                                    <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                            Background="{DynamicResource BondError}"
                                                            IsVisible="{Binding IsCritical}" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" Spacing="5">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Border Grid.Column="0" Width="6" Height="6"
                                                                    CornerRadius="3"
                                                                    Background="{DynamicResource BondError}"
                                                                    IsVisible="{Binding IsUnread}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,2,7,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                       TextWrapping="Wrap"
                                                                       Classes="announcement-title"
                                                                       Classes.unread="{Binding IsUnread}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                   FontSize="12" LineHeight="18"
                                                                   Foreground="{DynamicResource BondSecondary}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    Background="{DynamicResource BondSurfaceAlt}"
                                                                    IsVisible="{Binding IsInfo}">
                                                                <TextBlock Text="{Binding LevelText}" FontSize="10"
                                                                           Foreground="{DynamicResource BondTertiary}" />
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    Background="{DynamicResource BondWarning}"
                                                                    IsVisible="{Binding IsWarn}">
                                                                <TextBlock Text="{Binding LevelText}" FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BondOnAccent}" />
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    Background="{DynamicResource BondError}"
                                                                    IsVisible="{Binding IsCritical}">
                                                                <TextBlock Text="{Binding LevelText}" FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BondOnAccent}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                                       Foreground="{DynamicResource BondTertiary}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 首次加载 -->
                            <StackPanel IsVisible="{Binding ShowAnnouncementsLoading}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="10" Margin="0,40">
                                <ProgressBar IsIndeterminate="True" Width="150" Height="3" />
                                <TextBlock Text="正在加载公告…" Classes="meta"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- 空态 -->
                            <StackPanel IsVisible="{Binding IsAnnouncementsEmpty}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" Margin="0,44">
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="{DynamicResource BondSurfaceAlt}"
                                        HorizontalAlignment="Center">
                                    <mi:MaterialIcon Kind="BellOffOutline" IconSize="20"
                                                     Foreground="{DynamicResource BondTertiary}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="暂无公告" FontSize="12.5"
                                           Foreground="{DynamicResource BondSecondary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="有新公告会在这里显示" FontSize="11"
                                           Foreground="{DynamicResource BondTertiary}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </Grid>

                    <Border Grid.Row="3" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BondBorder}" Padding="16,9">
                        <TextBlock Text="点击公告即标记为已读" FontSize="10.5"
                                   Foreground="{DynamicResource BondTertiary}" />
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== 预览覆盖层（双击文件；单独一层，避免 Hosts 吃掉整个窗口点击）===== -->
        <Border x:Name="PreviewOverlay" IsVisible="{Binding Preview.IsOpen}"
                    Background="{DynamicResource BondScrim}"
                    PointerPressed="OnPreviewBackdropPressed">
                <Border Background="{DynamicResource BondSurface}"
                        BorderBrush="{DynamicResource BondBorder}" BorderThickness="1"
                        CornerRadius="14" Margin="52,36" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- 头部 -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12">
                            <Border Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource BondAccentSoft}"
                                    VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="EyeOutline" IconSize="16"
                                                 Foreground="{DynamicResource BondAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center"
                                        Spacing="1">
                                <TextBlock Text="{Binding Preview.Title}" FontSize="13.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" ToolTip.Tip="{Binding Preview.Title}" />
                                <TextBlock Text="{Binding Preview.MetaText}" Classes="meta" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Preview.PositionText}" Classes="meta"
                                           VerticalAlignment="Center" />
                                <Button Classes="ghosticon" Padding="6" MinWidth="32" MinHeight="32"
                                        Command="{Binding Preview.CloseCommand}" ToolTip.Tip="关闭 (Esc)">
                                    <mi:MaterialIcon Kind="Close" IconSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="0" Classes="rule" Margin="0" VerticalAlignment="Bottom" />

                        <!-- 内容 -->
                        <Border Grid.Row="1" Background="{DynamicResource BondBg}" ClipToBounds="True">
                            <Panel>
                                <Image x:Name="PreviewImage" Source="{Binding Preview.ImageSource}"
                                       Stretch="Uniform" RenderTransformOrigin="50%,50%"
                                       IsVisible="{Binding Preview.HasImage}"
                                       PointerWheelChanged="OnPreviewWheel"
                                       DoubleTapped="OnPreviewDoubleTapped"
                                       PointerPressed="OnPreviewImagePressed"
                                       PointerMoved="OnPreviewImageMoved"
                                       PointerReleased="OnPreviewImageReleased" />

                                <!-- 视频：LibVLC 解帧 → WriteableBitmap -->
                                <Panel IsVisible="{Binding Preview.IsVideoPreview}">
                                    <Image x:Name="PreviewVideoImage"
                                           Source="{Binding Preview.VideoFrame}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding Preview.IsVideoAvailable}" />

                                    <StackPanel IsVisible="{Binding Preview.IsVideoLoading}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Spacing="10" MaxWidth="420">
                                        <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
                                        <TextBlock Text="{Binding Preview.VideoStatusText}" Classes="meta"
                                                   TextAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding Preview.IsVideoUnavailable}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Spacing="10" MaxWidth="460">
                                        <Border Width="56" Height="56" CornerRadius="28"
                                                Background="{DynamicResource BondSurfaceAlt}"
                                                HorizontalAlignment="Center">
                                            <mi:MaterialIcon Kind="PlayCircleOutline" IconSize="24"
                                                             Foreground="{DynamicResource BondTertiary}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Preview.VideoStatusText}" Classes="meta"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="可点右下角“用默认程序打开”播放" Classes="meta"
                                                   Foreground="{DynamicResource BondTertiary}"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Panel>

                                <!-- PDF 阅读器：本地 PDFium 渲染，连续滚动 + 缩放 + 旋转 -->
                                <controls:PdfReaderView Document="{Binding Preview.PdfDocument}"
                                                        IsVisible="{Binding Preview.IsPdfReaderAvailable}" />

                                <!-- 办公文档（task-60）：服务端转 PDF 的进行中状态，不显示假百分比 -->
                                <StackPanel IsVisible="{Binding Preview.IsOfficeLoading}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="10" MaxWidth="460">
                                    <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
                                    <TextBlock Text="{Binding Preview.OfficeStatusText}" Classes="meta"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBox Text="{Binding Preview.TextContent}"
                                         IsVisible="{Binding Preview.IsTextPreview}"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                         Background="Transparent" BorderThickness="0" Margin="16"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                                <StackPanel IsVisible="{Binding Preview.ShowInfoPanel}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="10" MaxWidth="480">
                                    <Border Width="56" Height="56" CornerRadius="28"
                                            Background="{DynamicResource BondSurfaceAlt}">
                                        <mi:MaterialIcon Kind="FileDocumentOutline" IconSize="24"
                                                         Foreground="{DynamicResource BondTertiary}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Preview.KindText}" FontSize="13"
                                               FontWeight="Medium" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Preview.MetaText}" Classes="meta"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Preview.NoteText}" FontSize="11.5"
                                               Foreground="{DynamicResource BondTertiary}"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 错误态：不白屏 -->
                                <Border IsVisible="{Binding Preview.HasError}" Padding="16,12"
                                        CornerRadius="10" MaxWidth="520"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource BondSurfaceAlt}"
                                        BorderBrush="{DynamicResource BondBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="AlertCircleOutline" IconSize="16"
                                                         Foreground="{DynamicResource BondError}"
                                                         VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Preview.ErrorText}" FontSize="12.5"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ProgressBar Height="2" IsIndeterminate="True"
                                             VerticalAlignment="Top"
                                             IsVisible="{Binding Preview.IsLoading}" />
                            </Panel>
                        </Border>

                        <!-- 底部操作 -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="16,10">
                            <!-- 视频播放控制条 -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Preview.IsVideoAvailable}">
                                <Button Classes="ghosticon" Padding="6" MinWidth="32" MinHeight="32"
                                        Command="{Binding Preview.TogglePlayCommand}" ToolTip.Tip="播放/暂停 (空格)">
                                    <Panel>
                                        <mi:MaterialIcon Kind="Play" IconSize="15"
                                                         IsVisible="{Binding !Preview.IsPlaying}" />
                                        <mi:MaterialIcon Kind="Pause" IconSize="15"
                                                         IsVisible="{Binding Preview.IsPlaying}" />
                                    </Panel>
                                </Button>
                                <TextBlock Text="{Binding Preview.TimeText}" Classes="meta"
                                           FontFamily="Consolas" VerticalAlignment="Center" MinWidth="42" />
                                <Slider Width="280" Minimum="0" Maximum="1" MinHeight="20"
                                        Value="{Binding Preview.PositionValue, Mode=TwoWay}"
                                        VerticalAlignment="Center" ToolTip.Tip="拖动定位" />
                                <TextBlock Text="{Binding Preview.DurationText}" Classes="meta"
                                           FontFamily="Consolas" VerticalAlignment="Center" MinWidth="42" />
                                <Button Classes="ghosticon" Padding="6" MinWidth="32" MinHeight="32"
                                        Command="{Binding Preview.CycleSpeedCommand}" ToolTip.Tip="倍速">
                                    <TextBlock Text="{Binding Preview.SpeedText}" FontSize="11.5" />
                                </Button>
                                <mi:MaterialIcon Kind="VolumeHigh" IconSize="14"
                                                 Foreground="{DynamicResource BondTertiary}"
                                                 VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Slider Width="90" Minimum="0" Maximum="100" MinHeight="20"
                                        Value="{Binding Preview.Volume, Mode=TwoWay}"
                                        VerticalAlignment="Center" ToolTip.Tip="音量" />
                                <Button Classes="ghosticon" Padding="6" MinWidth="32" MinHeight="32"
                                        Click="OnVideoFullscreen" ToolTip.Tip="全屏 (F)">
                                    <mi:MaterialIcon Kind="Fullscreen" IconSize="15" />
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding Preview.NoteText}" Classes="meta"
                                       IsVisible="{Binding !Preview.IsVideoPreview}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       MaxWidth="620" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Preview.NoteText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Classes="soft" Command="{Binding Preview.PrevCommand}"
                                        IsEnabled="{Binding Preview.CanGoPrev}" Padding="10,5"
                                        ToolTip.Tip="上一张 (←)">
                                    <mi:MaterialIcon Kind="ChevronLeft" IconSize="14" />
                                </Button>
                                <Button Classes="soft" Command="{Binding Preview.NextCommand}"
                                        IsEnabled="{Binding Preview.CanGoNext}" Padding="10,5"
                                        ToolTip.Tip="下一张 (→)">
                                    <mi:MaterialIcon Kind="ChevronRight" IconSize="14" />
                                </Button>
                                <Button Classes="soft" Command="{Binding Preview.ResetZoomCommand}"
                                        Padding="12,5" IsVisible="{Binding Preview.HasImage}"
                                        ToolTip.Tip="双击图片也可复位缩放">
                                    <TextBlock Text="重置缩放" FontSize="12" />
                                </Button>
                                <Button Classes="soft" Command="{Binding Preview.DownloadCommand}"
                                        Padding="12,5">
                                    <TextBlock Text="下载" FontSize="12" />
                                </Button>
                                <Button Classes="primary" Command="{Binding Preview.OpenExternalCommand}"
                                        Padding="14,5" ToolTip.Tip="用系统默认程序打开（视频走这里）">
                                    <TextBlock Text="用默认程序打开" FontSize="12" Foreground="{DynamicResource BondOnAccent}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

        <!-- ===== task-133：键盘快捷键帮助浮层（? / Ctrl+/ 打开，Esc 关闭）===== -->
        <controls:ShortcutsOverlay x:Name="ShortcutsLayer" />
    </suki:SukiWindow.Hosts>
</suki:SukiWindow>
