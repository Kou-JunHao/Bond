<Window x:Class="BondClient.Views.FloatingBallWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BondClient.ViewModels"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="False"
        Title="Bond"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Border Name="RootContainer" Background="Transparent" Padding="20">
        <Panel>
            <Border Name="BallBorder"
                    Width="56" Height="56"
                    CornerRadius="28"
                    Background="{DynamicResource BondBg}"
                    BorderBrush="{DynamicResource BondBorder}"
                    BorderThickness="1"
                    BoxShadow="0 2 12 0 #18000000"
                    RenderTransformOrigin="50%,50%"
                    PointerPressed="OnPointerPressed"
                    PointerMoved="OnPointerMoved"
                    PointerReleased="OnPointerReleased"
                    PointerEntered="OnPointerEntered"
                    PointerExited="OnPointerExited">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,56,56" RadiusX="28" RadiusY="28" />
                </Border.Clip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#x9000;&#x51FA;" Click="OnExitClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>

                <Panel>
                    <Border Name="PanelContent" Background="Transparent" Opacity="0" IsVisible="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Height="56" LastChildFill="True">
                                <Button Name="SettingsBtn" Classes="Basic"
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        Click="OnSettingsClick" IsVisible="False"
                                        Margin="0,0,12,0"
                                        Padding="8" MinWidth="36" MinHeight="36">
                                    <Path Width="16" Height="16"
                                          Data="{StaticResource Ico.Settings}"
                                          Stroke="{DynamicResource BondStroke}" />
                                </Button>
                                <TextBlock Name="DeviceNameDisplay"
                                           FontSize="15" FontWeight="600"
                                           Foreground="{DynamicResource BondPrimary}"
                                           VerticalAlignment="Center"
                                           Margin="42,0,0,0" />
                            </DockPanel>

                            <Panel Grid.Row="1" Margin="14,0,14,14">

                                <!-- ===== Login ===== -->
                                <Panel Name="LoginPanel" IsVisible="False">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="&#x767B;&#x5F55;" FontSize="15" FontWeight="600"
                                                   Foreground="{DynamicResource BondPrimary}"
                                                   Margin="0,0,0,12" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x7528;&#x6237;&#x540D;" FontSize="12"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <TextBox Name="LoginUsername" PlaceholderText="&#x8F93;&#x5165;&#x7528;&#x6237;&#x540D;" />
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x5BC6;&#x7801;" FontSize="12"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <TextBox Name="LoginPassword" PlaceholderText="&#x8F93;&#x5165;&#x5BC6;&#x7801;"
                                                             PasswordChar="&#x25CF;" KeyDown="OnLoginKeyDown" />
                                                </StackPanel>

                                                <!-- Captcha -->
                                                <Panel Name="LoginCaptchaPanel" IsVisible="False">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="验证码" FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}" />
                                                        <DockPanel LastChildFill="True">
                                                            <Button Name="LoginCaptchaRefreshBtn" Classes="Basic"
                                                                    DockPanel.Dock="Right"
                                                                    Click="OnRefreshCaptcha" Padding="6"
                                                                    MinWidth="36" MinHeight="36"
                                                                    VerticalAlignment="Bottom"
                                                                    ToolTip.Tip="刷新验证码">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.ArrowRotate}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                            </Button>
                                                            <Image Name="LoginCaptchaImage" Width="100" Height="36"
                                                                   DockPanel.Dock="Right"
                                                                   Margin="0,0,8,0"
                                                                   Cursor="Hand"
                                                                   PointerPressed="OnRefreshCaptcha"
                                                                   ToolTip.Tip="点击刷新"
                                                                   Stretch="Uniform" />
                                                            <TextBox Name="LoginCaptchaInput"
                                                                     PlaceholderText="请输入验证码"
                                                                     FontSize="13" Height="36" CornerRadius="8"
                                                                     KeyDown="OnLoginKeyDown"
                                                                     Margin="0,0,8,0" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Panel>

                                                <TextBlock Name="LoginError" FontSize="11"
                                                           Foreground="{DynamicResource BondError}"
                                                           TextWrapping="Wrap" MinHeight="16" />
                                                <Button Name="LoginSubmitBtn" Classes="Outlined"
                                                        Click="OnLoginSubmit" Padding="12,6"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        MinHeight="36">
                                                    <TextBlock Name="LoginSubmitText" Text="&#x767B;&#x5F55;" FontSize="13" FontWeight="600"
                                                               Foreground="{DynamicResource BondSecondary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            HorizontalAlignment="Center">
                                                    <Button Name="LoginToggleBtn" Classes="Outlined"
                                                            Click="OnLoginToggleMode" Padding="10,4"
                                                            HorizontalContentAlignment="Center">
                                                        <TextBlock Name="LoginToggleText" FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   Text="&#x6CA1;&#x6709;&#x8D26;&#x53F7;&#xFF1F;&#x53BB;&#x6CE8;&#x518C;"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                </StackPanel>
                                                <Border Height="1" Background="{DynamicResource BondBorder}" Margin="0,4,0,0" />
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            HorizontalAlignment="Center">
                                                    <Button Name="LanOnlyBtn" Classes="Outlined"
                                                            Click="OnLanOnlyClick" Padding="10,4"
                                                            HorizontalContentAlignment="Center">
                                                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                                            <Run Text="&#x6211;&#x4EC5;&#x4F7F;&#x7528;&#x5C40;&#x57DF;&#x7F51;&#x4F20;&#x8F93;&#x529F;&#x80FD;" Foreground="{DynamicResource BondAccent}" />
                                                            <Run Text=" &#x2192;" Foreground="{DynamicResource BondTertiary}" />
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Panel>

                                <!-- ===== Dashboard ===== -->
                                <Panel Name="DashboardPanel" IsVisible="False">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="12">

                                            <!-- Account Card (logged in) -->
                                            <suki:GlassCard Name="DashAccountCard" IsOpaque="True" IsVisible="False">
                                                <StackPanel Spacing="8">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10"
                                                                    VerticalAlignment="Center">
                                                            <Border Width="36" Height="36" CornerRadius="18"
                                                                    Background="{DynamicResource BondSurface}"
                                                                    BorderBrush="{DynamicResource BondBorder}" BorderThickness="1">
                                                                <Path Width="18" Height="18"
                                                                      Data="{StaticResource Ico.Person}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                            </Border>
                                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                                <TextBlock Name="DashAccountName" FontSize="13" FontWeight="600"
                                                                           Foreground="{DynamicResource BondPrimary}" />
                                                                <TextBlock Name="DashAccountStatus" FontSize="11"
                                                                           Foreground="{DynamicResource BondTertiary}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Name="DashProfileBtn" Classes="Basic"
                                                                DockPanel.Dock="Right" VerticalAlignment="Center"
                                                                Click="OnDashOpenProfile" Padding="6">
                                                            <Path Width="14" Height="14"
                                                                  Data="{StaticResource Ico.Settings}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                        </Button>
                                                    </DockPanel>
                                                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" Margin="0,4,0,0">
                                                        <Button Grid.Column="0" Classes="Outlined"
                                                                Click="OnDashOpenWorkspace" Padding="4,6"
                                                                HorizontalAlignment="Stretch">
                                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Folder}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="工作区" FontSize="10"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="Outlined"
                                                                Click="OnDashOpenFriend" Padding="4,6"
                                                                HorizontalAlignment="Stretch" Margin="4,0">
                                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Person}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="好友" FontSize="10"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="Outlined"
                                                                Click="OnDashOpenCloudInbox" Padding="4,6"
                                                                HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.ArrowRotate}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="收件箱" FontSize="10"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="3" Classes="Outlined"
                                                                Click="OnDashOpenTransferHistory" Padding="4,6"
                                                                HorizontalAlignment="Stretch">
                                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.ChevronRight}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="历史" FontSize="10"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </suki:GlassCard>

                                            <!-- Login Prompt Card (not logged in) -->
                                            <suki:GlassCard Name="DashLoginCard" IsOpaque="True" IsVisible="False">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10"
                                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Path Width="16" Height="16"
                                                              Data="{StaticResource Ico.Person}"
                                                              Stroke="{DynamicResource BondStroke}" />
                                                        <TextBlock Text="&#x767B;&#x5F55;&#x540E;&#x53EF;&#x4F7F;&#x7528;&#x8DE8;&#x7F51;&#x4F20;&#x8F93;&#x548C;&#x5DE5;&#x4F5C;&#x533A;"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Name="DashLoginBtn" Classes="Outlined"
                                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                                            Click="OnDashLogin" Padding="10,4"
                                                            HorizontalContentAlignment="Center">
                                                        <TextBlock Text="&#x767B;&#x5F55;" FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   VerticalAlignment="Center" />
                                                    </Button>
                                                </DockPanel>
                                            </suki:GlassCard>

                                            <suki:GlassCard IsOpaque="True">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                              Data="{StaticResource Ico.Lock}"
                                                              Stroke="{DynamicResource BondStroke}" />
                                                        <TextBlock Grid.Column="1" Text="&#x63A5;&#x6536;&#x5BC6;&#x7801;"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Name="DashPasswordDisplay"
                                                                   FontSize="20" FontWeight="700"
                                                                   Foreground="{DynamicResource BondPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   DockPanel.Dock="Left"
                                                                   Margin="24,0,0,0" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    DockPanel.Dock="Right"
                                                                    VerticalAlignment="Center">
                                                            <Button Classes="Outlined" Padding="8,4"
                                                                    Click="OnDashCopyPassword">
                                                                <Grid ColumnDefinitions="Auto,Auto">
                                                                    <Path Grid.Column="0" Width="16" Height="16"
                                                                          Data="{StaticResource Ico.Copy}"
                                                                          Stroke="{DynamicResource BondStroke}" />
                                                                    <TextBlock Grid.Column="1" Text="&#x590D;&#x5236;" FontSize="11"
                                                                               Foreground="{DynamicResource BondSecondary}"
                                                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Classes="Outlined" Padding="8,4"
                                                                    Click="OnDashRegeneratePassword">
                                                                <Grid ColumnDefinitions="Auto,Auto">
                                                                    <Path Grid.Column="0" Width="16" Height="16"
                                                                          Data="{StaticResource Ico.Refresh}"
                                                                          Stroke="{DynamicResource BondStroke}" />
                                                                    <TextBlock Grid.Column="1" Text="&#x5237;&#x65B0;" FontSize="11"
                                                                               Foreground="{DynamicResource BondSecondary}"
                                                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                </Grid>
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </suki:GlassCard>

                                            <suki:GlassCard IsOpaque="True">
                                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                    <Path Width="32" Height="32"
                                                          Data="{StaticResource Ico.Attach}"
                                                          HorizontalAlignment="Center"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                    <TextBlock Text="&#x62D6;&#x62FD;&#x6587;&#x4EF6;&#x5230;&#x60AC;&#x6D6E;&#x7403;&#x5373;&#x53EF;&#x53D1;&#x9001;"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BondSecondary}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="&#x652F;&#x6301;&#x6587;&#x4EF6;&#x548C;&#x6587;&#x4EF6;&#x5939;"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource BondSecondary}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </suki:GlassCard>

                                            <suki:GlassCard IsOpaque="True">
                                                <StackPanel Spacing="8">
                                                    <DockPanel LastChildFill="True">
                                                        <Panel DockPanel.Dock="Right">
                                                            <Button Classes="Basic" Padding="4"
                                                                    MinWidth="24" MinHeight="24" Cursor="Hand"
                                                                    Name="RefreshDevicesBtn"
                                                                    Click="OnDashRefreshDevices">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Refresh}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                            </Button>
                                                            <Popup Name="SubnetPopup"
                                                                   PlacementTarget="{Binding #RefreshDevicesBtn}"
                                                                   Placement="BottomEdgeAlignedRight"
                                                                   IsLightDismissEnabled="True"
                                                                   IsOpen="False">
                                                                 <Border Name="SubnetPopupBorder" CornerRadius="8"
                                                                         Padding="4" MinWidth="240"
                                                                         Background="{DynamicResource BondSurface}"
                                                                         BorderBrush="{DynamicResource BondBorder}" BorderThickness="1"
                                                                         BoxShadow="0 4 16 0 #20000000">
                                                                    <StackPanel Name="SubnetList" Spacing="2" />
                                                                </Border>
                                                            </Popup>
                                                        </Panel>
                                                        <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                                                            <Path Grid.Column="0" Width="16" Height="16"
                                                                  Data="{StaticResource Ico.Globe}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                            <TextBlock Grid.Column="1" FontSize="12"
                                                                       Foreground="{DynamicResource BondSecondary}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Run Text="&#x9644;&#x8FD1;&#x8BBE;&#x5907; " />
                                                                <Run Name="DashDeviceCount" Text="" />
                                                            </TextBlock>
                                                            <Border Grid.Column="2" Name="DashConnectionDot" Width="8" Height="8"
                                                                    CornerRadius="4" Background="{DynamicResource BondDisabled}"
                                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </DockPanel>
                                                    <Panel>
                                                        <StackPanel Name="DashLoadingIndicator"
                                                                    Orientation="Horizontal" Spacing="6"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="True">
                                                            <Border Classes="loading-dot" />
                                                            <Border Classes="loading-dot" />
                                                            <Border Classes="loading-dot" />
                                                            <TextBlock Text="&#x6B63;&#x5728;&#x641C;&#x7D22;"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource BondSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="4,0,0,0" />
                                                        </StackPanel>
                                                        <ItemsControl Name="DashDeviceList"
                                                                      x:DataType="vm:TransferViewModel"
                                                                      ItemsSource="{Binding Devices}"
                                                                      IsVisible="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DeviceItem">
                                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                                                          Margin="0,3">
                                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                                              Data="{StaticResource Ico.Desktop}"
                                                                              Stroke="{DynamicResource BondStroke}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Device.Name}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Device.Ip, StringFormat='({0})'}"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Name="DashEmptyHint"
                                                                   Text="&#x6B63;&#x5728;&#x641C;&#x7D22;&#x9644;&#x8FD1;&#x8BBE;&#x5907;&#x2026;&#x2026;"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="False" />
                                                    </Panel>
                                                </StackPanel>
                                            </suki:GlassCard>

                                            <suki:GlassCard Name="DashRecentCard" IsOpaque="True" IsVisible="False">
                                                <StackPanel Spacing="8">
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right" Classes="Basic" Padding="4"
                                                                MinWidth="24" MinHeight="24"
                                                                Click="OnDashOpenDownloadFolder">
                                                            <Path Width="14" Height="14"
                                                                  Data="{StaticResource Ico.Folder}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                        </Button>
                                                        <Grid ColumnDefinitions="Auto,Auto">
                                                            <Path Grid.Column="0" Width="16" Height="16"
                                                                  Data="{StaticResource Ico.Folder}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                            <TextBlock Grid.Column="1" Text="&#x6700;&#x8FD1;&#x63A5;&#x6536;"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource BondSecondary}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </DockPanel>
                                                    <ItemsControl Name="DashRecentList"
                                                                  x:DataType="vm:TransferViewModel"
                                                                  ItemsSource="{Binding RecentFiles}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RecentFile">
                                                                <DockPanel Margin="0,2" LastChildFill="True">
                                                                    <Path Width="14" Height="14"
                                                                          Data="{StaticResource Ico.Document}"
                                                                          VerticalAlignment="Center"
                                                                          DockPanel.Dock="Left" Margin="0,0,8,0"
                                                                          Stroke="{DynamicResource BondStroke}" />
                                                                    <TextBlock Text="{Binding TimeAgo}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource BondTertiary}"
                                                                               VerticalAlignment="Center"
                                                                               DockPanel.Dock="Right" />
                                                                    <TextBlock Text="{Binding FileName}"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource BondSecondary}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </suki:GlassCard>

                                            <TextBlock Text="Bond v1.0" FontSize="10"
                                                       Foreground="{DynamicResource BondTertiary}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Panel>

                                <!-- ===== Approval ===== -->
                                <Panel Name="ApprovalPanel" IsVisible="False">
                                    <!-- Approval List View -->
                                    <Panel Name="ApprovalListView" IsVisible="True">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                                <Button Grid.Column="0" Classes="Basic"
                                                        Click="OnBackToDashboard" Padding="8"
                                                        MinWidth="32" MinHeight="32" DockPanel.Dock="Left">
                                                    <Path Width="16" Height="16"
                                                          Data="{StaticResource Ico.ChevronLeft}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                </Button>
                                                <Grid DockPanel.Dock="Left" ColumnDefinitions="Auto,Auto,Auto"
                                                      VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Path Grid.Column="0" Width="16" Height="16"
                                                          Data="{StaticResource Ico.Mail}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="600"
                                                               Foreground="{DynamicResource BondPrimary}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Run Text="&#x4F20;&#x8F93;&#x8BF7;&#x6C42; " />
                                                        <Run Name="ApprovalCount" Text="" Foreground="{DynamicResource BondAccent}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DockPanel>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Name="ApprovalListPanel" Spacing="6" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Panel>
                                    <!-- Approval Detail View -->
                                    <Panel Name="ApprovalDetailView" IsVisible="False">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                                <Button Classes="Basic" DockPanel.Dock="Left"
                                                        Click="OnApprovalBackToList" Padding="8"
                                                        MinWidth="32" MinHeight="32">
                                                    <Path Width="16" Height="16"
                                                          Data="{StaticResource Ico.ChevronLeft}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                </Button>
                                                <TextBlock DockPanel.Dock="Left" FontSize="14" FontWeight="600"
                                                           Foreground="{DynamicResource BondPrimary}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Text="&#x8BF7;&#x6C42;&#x8BE6;&#x60C5;" />
                                            </DockPanel>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Spacing="8">
                                                    <!-- Sender info -->
                                                    <suki:GlassCard IsOpaque="True">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="Auto,Auto,Auto">
                                                                <Path Grid.Column="0" Width="16" Height="16"
                                                                      Data="{StaticResource Ico.Person}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Grid.Column="1" Name="DetailFromName"
                                                                           FontSize="14" FontWeight="600"
                                                                           Foreground="{DynamicResource BondPrimary}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                <TextBlock Grid.Column="2" Name="DetailFromIp"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource BondTertiary}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </Grid>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" FontSize="12"
                                                                           Foreground="{DynamicResource BondSecondary}">
                                                                    <Run Name="DetailFileCount" />
                                                                    <Run Text="&#x4E2A;&#x6587;&#x4EF6; " />
                                                                    <Run Name="DetailTotalSize" />
                                                                </TextBlock>
                                                                <TextBlock DockPanel.Dock="Right" Name="DetailCountdown"
                                                                           FontSize="12" FontWeight="600"
                                                                           Foreground="{DynamicResource BondAccent}"
                                                                           HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </suki:GlassCard>
                                                    <!-- File list -->
                                                    <suki:GlassCard IsOpaque="True">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="Auto,Auto">
                                                                <Path Grid.Column="0" Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Document}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Grid.Column="1" Text="&#x6587;&#x4EF6;&#x5217;&#x8868;" FontSize="12"
                                                                           Foreground="{DynamicResource BondSecondary}"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                                            </Grid>
                                                            <ItemsControl Name="DetailFileList">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:Object">
                                                                        <DockPanel Margin="0,2" LastChildFill="True">
                                                                            <Path DockPanel.Dock="Left" Width="14" Height="14"
                                                                                  Data="{StaticResource Ico.Document}"
                                                                                  Stroke="{DynamicResource BondStroke}"
                                                                                  Margin="0,0,8,0" />
                                                                            <TextBlock FontSize="12"
                                                                                       Foreground="{DynamicResource BondPrimary}"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </suki:GlassCard>
                                                    <!-- Action buttons -->
                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                HorizontalAlignment="Center" Margin="0,4,0,0">
                                                        <Button Content="&#x63A5;&#x53D7;" Classes="Outlined"
                                                                Click="OnApproveRequest" Padding="16,6"
                                                                FontSize="13" FontWeight="600" />
                                                        <Button Content="&#x62D2;&#x7EDD;" Classes="Outlined"
                                                                Click="OnRejectRequest" Padding="20,8"
                                                                FontSize="13" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Panel>
                                </Panel>

                                <!-- ===== Transfer ===== -->
                                <Panel Name="TransferPanel" IsVisible="False">

                                    <DockPanel Name="TransferSelectMode">
                                        <!-- Header: back + file info -->
                                        <suki:GlassCard DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12" IsOpaque="True">
                                            <DockPanel LastChildFill="True">
                                                <Button Classes="Basic" DockPanel.Dock="Left"
                                                        Click="OnBackToDashboard" Padding="6"
                                                        MinWidth="28" MinHeight="28" Margin="0,0,8,0">
                                                    <Path Width="16" Height="16"
                                                          Data="{StaticResource Ico.ChevronLeft}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                </Button>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <Path Grid.Column="0" Width="14" Height="14"
                                                              Data="{StaticResource Ico.Attach}"
                                                              Stroke="{DynamicResource BondStroke}" />
                                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="600"
                                                                   Foreground="{DynamicResource BondPrimary}"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0">
                                                            <Run Text="&#x5F85;&#x53D1;&#x9001; " />
                                                            <Run Name="FileCountLabel" Text="" Foreground="{DynamicResource BondAccent}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </DockPanel>
                                        </suki:GlassCard>

                                        <!-- File list -->
                                        <suki:GlassCard DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12" IsOpaque="True">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto"
                                                      Margin="0,0,0,6">
                                                    <Path Grid.Column="0" Width="14" Height="14"
                                                          Data="{StaticResource Ico.Document}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                    <TextBlock Grid.Column="1" Text="&#x6587;&#x4EF6;&#x5217;&#x8868;" FontSize="12"
                                                               Foreground="{DynamicResource BondSecondary}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                                <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl Name="FileListControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <DockPanel Margin="0,2" LastChildFill="True">
                                                                    <Path DockPanel.Dock="Left" Width="14" Height="14"
                                                                          Data="{StaticResource Ico.Document}"
                                                                          Stroke="{DynamicResource BondStroke}"
                                                                          Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding}"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource BondPrimary}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </suki:GlassCard>

                                        <!-- Device list + Send button -->
                                        <suki:GlassCard IsOpaque="True">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto"
                                                      Margin="0,0,0,8">
                                                    <Path Grid.Column="0" Width="16" Height="16"
                                                          Data="{StaticResource Ico.Globe}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                    <TextBlock Grid.Column="1" FontSize="12"
                                                               Foreground="{DynamicResource BondSecondary}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Run Text="&#x9644;&#x8FD1;&#x8BBE;&#x5907; " />
                                                        <Run Name="DeviceCount" Text="" />
                                                    </TextBlock>
                                                </Grid>

                                                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                    <TextBlock Name="StatusText" Text="" FontSize="11"
                                                               Foreground="{DynamicResource BondTertiary}"
                                                               VerticalAlignment="Center"
                                                               DockPanel.Dock="Left" />
                                                     <Button DockPanel.Dock="Right" Classes="Outlined"
                                                             Click="OnSendClick" Padding="10,4">
                                                         <Grid ColumnDefinitions="Auto,Auto">
                                                             <Path Grid.Column="0" Width="16" Height="16"
                                                                   Data="{StaticResource Ico.Send}"
                                                                   Stroke="{DynamicResource BondStroke}" />
                                                             <TextBlock Grid.Column="1" Text="&#x53D1;&#x9001;"
                                                                        Foreground="{DynamicResource BondSecondary}"
                                                                        VerticalAlignment="Center" Margin="6,0,0,0" />
                                                         </Grid>
                                                    </Button>
                                                </DockPanel>

                                                <Panel>
                                                    <ItemsControl Name="DeviceListBox"
                                                                  ItemsSource="{Binding Devices}"
                                                                  x:DataType="vm:TransferViewModel">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DeviceItem">
                                                                <Border CornerRadius="8" Padding="8,6" Margin="0,2"
                                                                        BorderBrush="{DynamicResource BondBorder}" BorderThickness="1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <CheckBox DockPanel.Dock="Left"
                                                                                  IsChecked="{Binding IsSelected}"
                                                                                  IsCheckedChanged="OnDeviceChecked"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,10,0" />
                                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                                                    Spacing="6" VerticalAlignment="Center">
                                                                            <Path Width="16" Height="16"
                                                                                  Data="{StaticResource Ico.Desktop}"
                                                                                  Stroke="{DynamicResource BondStroke}" />
                                                                            <TextBlock Text="{Binding Device.Name}"
                                                                                       FontSize="13" FontWeight="500"
                                                                                       Foreground="{DynamicResource BondPrimary}"
                                                                                       VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Device.Ip, StringFormat='({0})'}"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource BondTertiary}"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <TextBox DockPanel.Dock="Right"
                                                                                 Text="{Binding EnteredPassword}"
                                                                                 IsVisible="{Binding PasswordVisible}"
                                                                                 PlaceholderText="&#x5BC6;&#x7801;"
                                                                                 FontSize="11" Height="28"
                                                                                 Width="80" CornerRadius="6"
                                                                                 Padding="6,2" Margin="8,0,0,0" />
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Name="EmptyHint"
                                                               FontSize="12" Foreground="{DynamicResource BondDisabled}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="False">
                                                        <Run Text="&#x672A;&#x53D1;&#x73B0;&#x8BBE;&#x5907;" /><LineBreak />
                                                        <Run Text="&#x8BF7;&#x786E;&#x4FDD;&#x5BF9;&#x65B9;&#x5DF2;&#x5F00;&#x542F; Bond" FontSize="10" />
                                                    </TextBlock>
                                                </Panel>
                                            </DockPanel>
                                        </suki:GlassCard>
                                    </DockPanel>

                                    <Panel Name="TransferProgressMode" IsVisible="False" Opacity="0">
                                        <StackPanel Spacing="12">
                                            <suki:GlassCard IsOpaque="True">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                              Data="{StaticResource Ico.Document}"
                                                              Stroke="{DynamicResource BondStroke}" />
                                                        <TextBlock Grid.Column="1" Name="ProgressFileName"
                                                                   FontSize="13" FontWeight="600"
                                                                   Foreground="{DynamicResource BondPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="280" Margin="8,0,0,0" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="2"
                                                                Height="4" />
                                                        <Border Name="ProgressBarFill" Grid.Column="0"
                                                                Background="{DynamicResource BondAccent}" CornerRadius="2" Height="4"
                                                                HorizontalAlignment="Left" Width="0" />
                                                    </Grid>

                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal" Spacing="12"
                                                                    DockPanel.Dock="Left"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Name="ProgressSpeed"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource BondSecondary}" />
                                                            <TextBlock Name="ProgressETA"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource BondSecondary}" />
                                                        </StackPanel>
                                                        <TextBlock Name="ProgressLabel"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   DockPanel.Dock="Right"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>

                                                    <TextBlock Name="ProgressPercent"
                                                               FontSize="20" FontWeight="700"
                                                               Foreground="{DynamicResource BondPrimary}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </suki:GlassCard>

                                            <Button Name="CancelTransferBtn"
                                                    Classes="Outlined" HorizontalAlignment="Center"
                                                    Click="OnCancelTransfer" Padding="16,8">
                                                <Grid ColumnDefinitions="Auto,Auto">
                                                    <Path Grid.Column="0" Width="16" Height="16"
                                                          Data="{StaticResource Ico.Close}"
                                                          Stroke="{DynamicResource BondStroke}" />
                                                    <TextBlock Grid.Column="1" Text="&#x53D6;&#x6D88;&#x4F20;&#x8F93;"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource BondSecondary}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Panel>
                                </Panel>

                                <!-- ===== Settings ===== -->
                                <Panel Name="SettingsPanel" IsVisible="False">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                            <Button Name="SettingsBackBtn" Classes="Basic"
                                                    DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Click="OnSettingsBack"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Ico.ChevronLeft}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                            <TextBlock Text="&#x8BBE;&#x7F6E;" FontSize="15" FontWeight="600"
                                                       Foreground="{DynamicResource BondPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </DockPanel>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x8BBE;&#x5907;&#x540D;&#x79F0;"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <TextBox Name="SettingsDeviceNameBox"
                                                             TextChanged="OnDeviceNameChanged" />
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x63A5;&#x6536;&#x5BC6;&#x7801;"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <suki:GlassCard IsOpaque="True">
                                                        <StackPanel Spacing="10">
                                                            <DockPanel LastChildFill="False">
                                                                <Grid DockPanel.Dock="Left" ColumnDefinitions="Auto,Auto"
                                                                      VerticalAlignment="Center">
                                                                    <Path Grid.Column="0" Width="16" Height="16"
                                                                          Data="{StaticResource Ico.Lock}"
                                                                          Stroke="{DynamicResource BondStroke}" />
                                                                    <TextBlock Grid.Column="1" Name="SettingsPasswordDisplay"
                                                                               FontSize="18" FontWeight="700"
                                                                               Foreground="{DynamicResource BondPrimary}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                </Grid>
                                                                <Button Name="SettingsCopyBtn" Classes="Outlined"
                                                                        Click="OnSettingsCopyPassword"
                                                                        DockPanel.Dock="Right"
                                                                        VerticalAlignment="Center"
                                                                        Padding="8,4">
                                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                                              Data="{StaticResource Ico.Copy}"
                                                                              Stroke="{DynamicResource BondStroke}" />
                                                                        <TextBlock Grid.Column="1" Text="&#x590D;&#x5236;"
                                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                    </Grid>
                                                                </Button>
                                                            </DockPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Classes="Outlined"
                                                                        Click="OnSettingsRegeneratePassword"
                                                                        Padding="8,4">
                                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                                              Data="{StaticResource Ico.Refresh}"
                                                                              Stroke="{DynamicResource BondStroke}" />
                                                                        <TextBlock Grid.Column="1" Text="&#x5237;&#x65B0;"
                                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                    </Grid>
                                                                </Button>
                                                                <Button Name="SettingsDisablePasswordBtn"
                                                                        Classes="Outlined"
                                                                        Click="OnSettingsDisablePassword"
                                                                        Padding="8,4">
                                                                    <TextBlock Text="&#x5173;&#x95ED;&#x5BC6;&#x7801;"
                                                                               Foreground="{DynamicResource BondSecondary}"
                                                                               VerticalAlignment="Center" />
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </suki:GlassCard>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x4E0B;&#x8F7D;&#x76EE;&#x5F55;"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <Border Name="SettingsDownloadPathBtn"
                                                            CornerRadius="8" Padding="10,8"
                                                            Cursor="Hand"
                                                            PointerPressed="OnSettingsBrowseFolder">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Path Grid.Column="0" Width="16" Height="16"
                                                                  Data="{StaticResource Ico.Folder}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                            <TextBlock Grid.Column="1" Name="SettingsDownloadPath"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource BondSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="8,0,8,0" />
                                                            <TextBlock Grid.Column="2" Text="&#x66F4;&#x6539;"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource BondSecondary}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x4F20;&#x8F93;&#x7AEF;&#x53E3;"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto">
                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                              Data="{StaticResource Ico.Wifi}"
                                                              Stroke="{DynamicResource BondStroke}" />
                                                        <TextBox Grid.Column="1" Name="SettingsPort"
                                                                 FontSize="12"
                                                                 VerticalAlignment="Center"
                                                                 Margin="8,0,0,0" Width="80"
                                                                 CornerRadius="6" Padding="6,4"
                                                                 MaxLength="5" />
                                                        <TextBlock Grid.Column="2" Text="&#x91CD;&#x542F;&#x540E;&#x751F;&#x6548;"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource BondTertiary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="&#x63A5;&#x6536;&#x8BBE;&#x7F6E;"
                                                               Foreground="{DynamicResource BondSecondary}" />
                                                    <suki:GlassCard IsOpaque="True">
                                                        <DockPanel LastChildFill="True">
                                                            <Grid DockPanel.Dock="Left" ColumnDefinitions="Auto,Auto"
                                                                  VerticalAlignment="Center">
                                                                <Path Grid.Column="0" Width="16" Height="16"
                                                                      Data="{StaticResource Ico.Send}"
                                                                      RenderTransform="scaleX(-1)"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                    <TextBlock Text="&#x65E0;&#x9700;&#x5BA1;&#x6279;&#x81EA;&#x52A8;&#x63A5;&#x6536;"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource BondSecondary}" />
                                                                    <TextBlock Text="&#x5176;&#x4ED6;&#x8BBE;&#x5907;&#x53EF;&#x76F4;&#x63A5;&#x53D1;&#x9001;&#x6587;&#x4EF6;"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource BondSecondary}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <ToggleSwitch Name="SettingsAutoApprove"
                                                                          DockPanel.Dock="Right"
                                                                          VerticalAlignment="Center"
                                                                          IsCheckedChanged="OnAutoApproveToggled" />
                                                        </DockPanel>
                                                    </suki:GlassCard>
                                                </StackPanel>
                                                <!-- Theme Toggle -->
                                                <suki:GlassCard IsOpaque="True">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    DockPanel.Dock="Left" VerticalAlignment="Center">
                                                            <Path Width="16" Height="16"
                                                                  Data="{StaticResource Ico.Desktop}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="&#x6DF1;&#x8272;&#x6A21;&#x5F0F;"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                                <TextBlock Text="&#x5207;&#x6362;&#x4EAE;&#x8272;/&#x6DF1;&#x8272;&#x754C;&#x9762;"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ToggleSwitch Name="SettingsThemeToggle"
                                                                      DockPanel.Dock="Right"
                                                                      VerticalAlignment="Center"
                                                                      IsCheckedChanged="OnThemeToggleSwitch" />
                                                    </DockPanel>
                                                </suki:GlassCard>
                                                <suki:GlassCard Name="AboutBondCard" IsOpaque="True"
                                                                PointerPressed="OnAboutPointerPressed"
                                                                PointerReleased="OnAboutPointerReleased"
                                                                Cursor="Hand">
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <Path Grid.Column="0" Width="16" Height="16"
                                                              Data="{StaticResource Ico.Info}"
                                                              Stroke="{DynamicResource BondStroke}" />
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="&#x5173;&#x4E8E; Bond" FontSize="13"
                                                                       FontWeight="600"
                                                                       Foreground="{DynamicResource BondPrimary}" />
                                                            <TextBlock Name="AboutSubtitle"
                                                                       Text="&#x5C40;&#x57DF;&#x7F51;&#x6587;&#x4EF6;&#x4F20;&#x8F93;&#x5DE5;&#x5177;"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource BondSecondary}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </suki:GlassCard>

                                                <!-- Debug Panel (hidden by default) -->
                                                <suki:GlassCard Name="DebugPanel" IsOpaque="True" IsVisible="False">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,Auto">
                                                            <Path Grid.Column="0" Width="16" Height="16"
                                                                  Data="{StaticResource Ico.Settings}"
                                                                  Stroke="{DynamicResource BondAccent}" />
                                                            <TextBlock Grid.Column="1" Text="&#x8C03;&#x8BD5;&#x6A21;&#x5F0F;" FontSize="13"
                                                                       FontWeight="600"
                                                                       Foreground="{DynamicResource BondAccent}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                        <TextBlock Text="&#x9762;&#x677F;&#x5BFC;&#x822A;" FontSize="11"
                                                                   Foreground="{DynamicResource BondTertiary}" />
                                                        <StackPanel Spacing="4">
                                                            <Button Content="&#x4EEA;&#x8868;&#x76D8;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugGoDashboard" />
                                                            <Button Content="&#x4F20;&#x8F93;&#x9762;&#x677F;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugGoTransfer" />
                                                            <Button Content="&#x5BA1;&#x6279;&#x9762;&#x677F;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugGoApproval" />
                                                            <Button Content="&#x8BBE;&#x7F6E;&#x9762;&#x677F;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugGoSettings" />
                                                            <Button Content="&#x767B;&#x5F55;&#x9762;&#x677F;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugGoLogin" />
                                                            <Button Content="&#x5DE5;&#x4F5C;&#x533A;&#x9762;&#x677F;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugGoWorkspace" />
                                                        </StackPanel>
                                                        <Border Height="1" Background="{DynamicResource BondBorder}" Margin="0,2" />
                                                        <TextBlock Text="&#x6D4B;&#x8BD5;&#x6570;&#x636E;" FontSize="11"
                                                                   Foreground="{DynamicResource BondTertiary}" />
                                                        <StackPanel Spacing="4">
                                                            <Button Content="&#x6DFB;&#x52A0; 3 &#x4E2A;&#x6D4B;&#x8BD5;&#x8BBE;&#x5907;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugAddFakeDevice" />
                                                            <Button Content="&#x6E05;&#x9664;&#x6D4B;&#x8BD5;&#x8BBE;&#x5907;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugClearFakeDevices" />
                                                            <Button Content="&#x6DFB;&#x52A0;&#x6D4B;&#x8BD5;&#x4F20;&#x8F93;&#x8BF7;&#x6C42;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugAddFakeRequest" />
                                                            <Button Content="&#x6E05;&#x9664;&#x6D4B;&#x8BD5;&#x8BF7;&#x6C42;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugClearFakeRequests" />
                                                        </StackPanel>
                                                        <Border Height="1" Background="{DynamicResource BondBorder}" Margin="0,2" />
                                                        <TextBlock Text="&#x5E94;&#x7528;&#x72B6;&#x6001;" FontSize="11"
                                                                   Foreground="{DynamicResource BondTertiary}" />
                                                        <StackPanel Spacing="4">
                                                            <Button Content="&#x5F3A;&#x5236;&#x663E;&#x793A;&#x767B;&#x5F55;&#x9762;&#x677F;" Classes="Outlined"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="DebugResetLogin" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Panel>

                                <!-- ===== Workspace ===== -->
                                <Panel Name="WorkspacePanel" IsVisible="False">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                            <Button Classes="Basic" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Click="OnBackToDashboard"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Ico.ChevronLeft}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                            <TextBlock Text="&#x5DE5;&#x4F5C;&#x533A;" FontSize="15" FontWeight="600"
                                                       Foreground="{DynamicResource BondPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </DockPanel>

                                        <Panel>
                                            <!-- Workspace List View -->
                                            <Panel Name="WorkspaceListView" IsVisible="True">
                                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Spacing="8">
                                                        <!-- Create workspace -->
                                                        <suki:GlassCard IsOpaque="True">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Text="&#x521B;&#x5EFA;&#x5DE5;&#x4F5C;&#x533A;" FontSize="12"
                                                                           FontWeight="600"
                                                                           Foreground="{DynamicResource BondPrimary}" />
                                                                <TextBox Name="WsNewName" PlaceholderText="&#x5DE5;&#x4F5C;&#x533A;&#x540D;&#x79F0;"
                                                                         FontSize="13" Height="36" CornerRadius="8" />
                                                                 <Button Content="&#x521B;&#x5EFA;" Classes="Outlined"
                                                                         Click="OnCreateWorkspace" Padding="12,6"
                                                                         FontSize="12" HorizontalAlignment="Right" />
                                                            </StackPanel>
                                                        </suki:GlassCard>

                                                        <!-- Workspace list -->
                                                        <StackPanel Name="WsListPanel" Spacing="6" />

                                                        <TextBlock Name="WsEmptyHint"
                                                                   Text="&#x8FD8;&#x6CA1;&#x6709;&#x5DE5;&#x4F5C;&#x533A;&#xFF0C;&#x521B;&#x5EFA;&#x4E00;&#x4E2A;&#x5427;"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource BondDisabled}"
                                                                   HorizontalAlignment="Center"
                                                                   IsVisible="False" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Panel>

                                            <!-- Workspace Files View -->
                                            <Panel Name="WorkspaceFilesView" IsVisible="False">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                        <Button Classes="Basic" DockPanel.Dock="Left"
                                                                Click="OnWsBackToList" Padding="6"
                                                                MinWidth="28" MinHeight="28" Margin="0,0,8,0">
                                                            <Path Width="16" Height="16"
                                                                  Data="{StaticResource Ico.ChevronLeft}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                        </Button>
                                                        <TextBlock Name="WsPathDisplay" FontSize="12"
                                                                   Foreground="{DynamicResource BondSecondary}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Name="WsUploadBtn" Classes="Outlined" DockPanel.Dock="Right"
                                                                Click="OnWsUpload" Padding="8,4"
                                                                MinWidth="28" MinHeight="28">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Upload}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="上传" FontSize="11"
                                                                           Foreground="{DynamicResource BondSecondary}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DockPanel>
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Name="WsFileList" Spacing="4" />
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Panel>
                                        </Panel>
                                    </DockPanel>
                                </Panel>

                                <!-- ===== Friends ===== -->
                                <Panel Name="FriendPanel" IsVisible="False">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                            <Button Classes="Basic" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Click="OnBackToDashboard"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Ico.ChevronLeft}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                            <TextBlock Text="&#x597D;&#x53CB;" FontSize="15" FontWeight="600"
                                                       Foreground="{DynamicResource BondPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </DockPanel>

                                        <Panel>
                                            <!-- Friend List View -->
                                            <Panel Name="FriendListView" IsVisible="True">
                                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Spacing="8">
                                                        <!-- Search -->
                                                        <suki:GlassCard IsOpaque="True">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Text="&#x641C;&#x7D22;&#x7528;&#x6237;" FontSize="12"
                                                                           FontWeight="600"
                                                                           Foreground="{DynamicResource BondPrimary}" />
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBox Name="FriendSearchBox" PlaceholderText="&#x8F93;&#x5165;&#x7528;&#x6237;&#x540D;/&#x6635;&#x79F0;"
                                                                             FontSize="13" Height="36" CornerRadius="8"
                                                                             KeyDown="OnFriendSearchKeyDown" />
                                                                </DockPanel>
                                                                <StackPanel Name="FriendSearchResults" Spacing="4" IsVisible="False" />
                                                            </StackPanel>
                                                        </suki:GlassCard>

                                                        <!-- Pending Requests -->
                                                        <suki:GlassCard IsOpaque="True">
                                                            <StackPanel Spacing="8">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="&#x5F85;&#x5904;&#x7406;&#x8BF7;&#x6C42;" FontSize="12"
                                                                               FontWeight="600"
                                                                               Foreground="{DynamicResource BondPrimary}"
                                                                               DockPanel.Dock="Left" />
                                                                    <TextBlock Name="FriendRequestCount" Text="" FontSize="11"
                                                                               Foreground="{DynamicResource BondDisabled}"
                                                                               DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                                                </DockPanel>
                                                                <StackPanel Name="FriendRequestList" Spacing="4" />
                                                                <TextBlock Name="FriendRequestEmpty"
                                                                           Text="&#x6682;&#x65E0;&#x8BF7;&#x6C42;"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource BondDisabled}"
                                                                           HorizontalAlignment="Center"
                                                                           IsVisible="True" />
                                                            </StackPanel>
                                                        </suki:GlassCard>

                                                        <!-- Friend List -->
                                                        <suki:GlassCard IsOpaque="True">
                                                            <StackPanel Spacing="8">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="&#x597D;&#x53CB;&#x5217;&#x8868;" FontSize="12"
                                                                               FontWeight="600"
                                                                               Foreground="{DynamicResource BondPrimary}"
                                                                               DockPanel.Dock="Left" />
                                                                    <TextBlock Name="FriendCount" Text="" FontSize="11"
                                                                               Foreground="{DynamicResource BondDisabled}"
                                                                               DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                                                </DockPanel>
                                                                <StackPanel Name="FriendListPanel" Spacing="4" />
                                                                <TextBlock Name="FriendListEmpty"
                                                                           Text="&#x8FD8;&#x6CA1;&#x6709;&#x597D;&#x53CB;&#xFF0C;&#x641C;&#x7D22;&#x6DFB;&#x52A0;&#x5427;"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource BondDisabled}"
                                                                           HorizontalAlignment="Center"
                                                                           IsVisible="True" />
                                                            </StackPanel>
                                                        </suki:GlassCard>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Panel>
                                        </Panel>
                                    </DockPanel>
                                </Panel>

                                <!-- ===== Profile ===== -->
                                <Panel Name="ProfilePanel" IsVisible="False">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                            <Button Classes="Basic" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Click="OnBackToDashboard"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Ico.ChevronLeft}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                            <TextBlock Text="个人中心" FontSize="15" FontWeight="600"
                                                       Foreground="{DynamicResource BondPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </DockPanel>

                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="12">
                                                <!-- Account Info -->
                                                <suki:GlassCard IsOpaque="True">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel LastChildFill="True">
                                                            <Path DockPanel.Dock="Left" Width="16" Height="16"
                                                                  Data="{StaticResource Ico.Person}"
                                                                  Stroke="{DynamicResource BondStroke}" />
                                                            <TextBlock DockPanel.Dock="Left" Text="账号信息"
                                                                       FontSize="12" FontWeight="600"
                                                                       Foreground="{DynamicResource BondPrimary}"
                                                                       Margin="8,0,0,0" />
                                                        </DockPanel>
                                                        <StackPanel Spacing="4">
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Left" Text="用户名"
                                                                           FontSize="11" Foreground="{DynamicResource BondDisabled}" />
                                                                <TextBlock DockPanel.Dock="Right" Name="ProfileUsername"
                                                                           FontSize="12" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Left" Text="昵称"
                                                                           FontSize="11" Foreground="{DynamicResource BondDisabled}" />
                                                                <TextBlock DockPanel.Dock="Right" Name="ProfileNickname"
                                                                           FontSize="12" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Left" Text="用户ID"
                                                                           FontSize="11" Foreground="{DynamicResource BondDisabled}" />
                                                                <TextBlock DockPanel.Dock="Right" Name="ProfileUserId"
                                                                           FontSize="11" Foreground="{DynamicResource BondDisabled}"
                                                                           HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </suki:GlassCard>

                                                <!-- Quick Actions -->
                                                <suki:GlassCard IsOpaque="True">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="快捷操作" FontSize="12" FontWeight="600"
                                                                   Foreground="{DynamicResource BondPrimary}" />
                                                        <Button Name="ProfileOpenDownloadBtn" Classes="Outlined"
                                                                Click="OnOpenDownloadFolder" Padding="10,6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Folder}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="打开下载目录" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Name="ProfileDeviceBtn" Classes="Outlined"
                                                                Click="OnOpenDeviceManager" Padding="10,6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Path Width="14" Height="14"
                                                                      Data="{StaticResource Ico.Desktop}"
                                                                      Stroke="{DynamicResource BondStroke}" />
                                                                <TextBlock Text="设备管理" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </suki:GlassCard>

                                                <!-- Device Manager -->
                                                <suki:GlassCard IsOpaque="True">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock Text="已注册设备" FontSize="12" FontWeight="600"
                                                                       Foreground="{DynamicResource BondPrimary}"
                                                                       DockPanel.Dock="Left" />
                                                            <Button Name="RegisterDeviceBtn" Classes="Outlined"
                                                                    Click="OnRegisterCurrentDevice"
                                                                    DockPanel.Dock="Right" Padding="8,4"
                                                                    FontSize="11">
                                                                <TextBlock Text="注册当前设备" FontSize="11"
                                                                           Foreground="{DynamicResource BondSecondary}" />
                                                            </Button>
                                                        </DockPanel>
                                                        <StackPanel Name="DeviceManagerList" Spacing="4" />
                                                        <TextBlock Name="DeviceManagerEmpty"
                                                                   Text="暂无已注册设备"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource BondDisabled}"
                                                                   HorizontalAlignment="Center"
                                                                   IsVisible="True" />
                                                    </StackPanel>
                                                </suki:GlassCard>

                                                <!-- Logout -->
                                                <suki:GlassCard IsOpaque="True">
                                                    <Button Name="ProfileLogoutBtn" Classes="Flat"
                                                            Click="OnLogout" Padding="10,6"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="{DynamicResource BondError}">
                                                        <TextBlock Text="退出登录" FontSize="12" Foreground="White" />
                                                    </Button>
                                                </suki:GlassCard>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Panel>

                                <!-- ===== Cloud Inbox ===== -->
                                <Panel Name="CloudInboxPanel" IsVisible="False">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                            <Button Classes="Basic" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Click="OnBackToDashboard"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Ico.ChevronLeft}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                            <TextBlock Text="云传输收件箱" FontSize="15" FontWeight="600"
                                                       Foreground="{DynamicResource BondPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            <Button Classes="Basic" DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    Click="OnRefreshCloudInbox"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="14" Height="14"
                                                      Data="{StaticResource Ico.ArrowRotate}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                        </DockPanel>

                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="8">
                                                <StackPanel Name="CloudInboxList" Spacing="6" />
                                                <TextBlock Name="CloudInboxEmpty"
                                                           Text="暂无待接收的云传输"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BondDisabled}"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="True" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Panel>

                                <!-- ===== Transfer History ===== -->
                                <Panel Name="TransferHistoryPanel" IsVisible="False">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="0,0,0,8">
                                            <Button Classes="Basic" DockPanel.Dock="Left"
                                                    VerticalAlignment="Center"
                                                    Click="OnBackToDashboard"
                                                    Padding="8" MinWidth="36" MinHeight="36">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Ico.ChevronLeft}"
                                                      Stroke="{DynamicResource BondStroke}" />
                                            </Button>
                                            <TextBlock Text="传输历史" FontSize="15" FontWeight="600"
                                                       Foreground="{DynamicResource BondPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </DockPanel>

                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="8">
                                                <StackPanel Name="TransferHistoryList" Spacing="6" />
                                                <TextBlock Name="TransferHistoryEmpty"
                                                           Text="暂无传输记录"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BondDisabled}"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="True" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Panel>

                            </Panel>
                        </Grid>
                    </Border>

                    <StackPanel Name="ToastContainer"
                                Orientation="Vertical" Spacing="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,6,0,0"
                                IsHitTestVisible="False" />

                    <Canvas IsHitTestVisible="False">
                        <Image Name="MorphIcon" Source="avares://BondClient/Assets/Icon.ico"
                               Width="28" Height="28" Canvas.Left="13" Canvas.Top="13"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                </Panel>
            </Border>
        </Panel>
    </Border>
</Window>