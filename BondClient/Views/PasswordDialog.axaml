<Window x:Class="BondClient.Views.PasswordDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        WindowDecorations="None"
        Width="340" Height="260"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <suki:GlassCard CornerRadius="14" Padding="24" IsOpaque="True">
        <StackPanel Spacing="16">
            <TextBlock Text="&#x5BC6;&#x7801;&#x7BA1;&#x7406;" FontSize="16" FontWeight="600" Foreground="#FF222222" />

            <StackPanel Spacing="6">
                <TextBlock Text="&#x5F53;&#x524D;&#x5BC6;&#x7801;" FontSize="11" Foreground="#FF888888" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Name="PasswordBox" Width="130" FontSize="20" IsReadOnly="True"
                             FontWeight="700" Foreground="#FF222222"
                             CornerRadius="8" Padding="10,8" />
                    <Button Content="&#x5237;&#x65B0;" Click="OnRegenerate" FontSize="12" Padding="10,6"
                            Classes="Outlined" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="DisableBtn" Content="&#x5173;&#x95ED;&#x5BC6;&#x7801;" Click="OnDisable"
                        FontSize="12" Padding="10,6" Classes="Outlined" />
                <Button Content="&#x590D;&#x5236;" Click="OnCopy" FontSize="12" Padding="10,6"
                        Classes="Outlined" />
            </StackPanel>

            <Button Content="&#x5B8C;&#x6210;" Click="OnDone" FontSize="13" Padding="16,7"
                    HorizontalAlignment="Right" Classes="Flat Accent" />
        </StackPanel>
    </suki:GlassCard>
</Window>
