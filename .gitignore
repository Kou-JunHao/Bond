# ============================================
# Bond Project .gitignore
# ============================================

# ── Build outputs ──
bin/
obj/
publish/
target/
BondClient/publish/
**/target/
*.exe
*.dll
*.pdb
*.class
*.jar
*.war

# ── IDE / Editor ──
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.swp
*.swo
*~

# ── AI / Local Tools ──
.kilo/
.mimocode/
.claude/
.github/

# ── Security: keys & credentials ──
*.key
*.pem
*.p12
*.pfx
*.cert
*.crt
*.jks
*.keystore
*.secret
*.cred
.env
.env.*
sshkey.key

# ── Production secrets ──
deploy/
SERVER_DEPLOY.md
PROJECT_REVIEW.md
BondServer/API_DOCS.md

# ── OS files ──
Thumbs.db
Desktop.ini
.DS_Store
*.lnk

# ── .NET / NuGet ──
packages/
*.nupkg

# ── Java / Maven ──
BondServer/.mvn/wrapper/*.jar
BondServer/.mvn/maven/

# ── Node.js ──
node_modules/
admin-web/dist/
admin-web/.vite/
admin-web/.pnpm-store/
*.local
*.tgz

# ── Client runtime data ──
BondClient/auth.json
BondClient/config.json
BondClient/position.txt
BondClient/resume/
BondClient/history.json
BondClient/add_firewall_rules.bat

# ── Logs & databases ──
*.log
*.sql
*.sqlite
*.sqlite3

# ── Package manager locks ──
package-lock.json
yarn.lock
bun.lock

# ── Misc ──
*.cache
*.tmp
*.bak
*.orig
