# ============================================
# Bond Project .gitignore
# ============================================

# ── Build outputs ──
bin/
obj/
publish/
target/
*.exe
*.dll
*.pdb
*.user
*.class
*.jar
*.war

# ── IDE ──
.vs/
.vscode/
.idea/
*.suo
*.userprefs
*.swp
*~

# ── AI Agent ──
.kilo/
.mimocode/
.claude/

# ── Sensitive files ──
*.key
*.pem
*.p12
*.keystore
*.env
.env.*
sshkey.key
deploy/
SERVER_DEPLOY.md
PROJECT_REVIEW.md
BondServer/API_DOCS.md

# ── OS ──
Thumbs.db
Desktop.ini
.DS_Store

# ── NuGet ──
packages/
*.nupkg

# ── Java / Maven ──
BondServer/**/target/
BondServer/.mvn/wrapper/*.jar
BondServer/.mvn/maven/

# ── Node.js ──
node_modules/
admin-web/dist/
admin-web/.pnpm-store/
*.tgz

# ── Client runtime data ──
BondClient/auth.json
BondClient/config.json
BondClient/position.txt
BondClient/resume/
BondClient/history.json
BondClient/add_firewall_rules.bat

# ── Logs ──
*.log

# ── Misc ──
*.cache
*.tmp
*.bak
*.orig
